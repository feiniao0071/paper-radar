# Feishu custom bot. Store real values in GitHub Actions Secrets.
FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=

# The Quantum AI workflow maps its own GitHub secrets into the variables above.
QUANTUM_AI_FEISHU_WEBHOOK_URL=
QUANTUM_AI_FEISHU_SIGNING_SECRET=

# Optional Responses API paper evaluation.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-sol
LLM_REASONING_EFFORT=low

# Optional contact information for the arXiv User-Agent header.
ARXIV_CONTACT=
